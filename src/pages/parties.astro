---
import Base from '../layouts/Base.astro';
import PartyCard from '../components/PartyCard.astro';
import ResultsBar from '../components/ResultsBar.astro';
import parties from '../data/parties.json';

const standing = parties.filter((p) => p.slug !== 'independent' && !p.notStanding);
const notStanding = parties.filter((p) => p.notStanding);
const independent = parties.find((p) => p.slug === 'independent');
---

<Base
  title="Parties — Clacton By-Election 2026"
  description="The parties contesting the 2026 Clacton by-election: their leaders, platforms and 2024 performance in the constituency."
>
  <h1>The parties</h1>
  <p class="lede">
    An unusual field. After Nigel Farage resigned and stood again, the main
    opposition parties said they would not contest the by-election, leaving
    Reform UK facing a line-up of smaller parties, novelty candidates and
    independents. Platform summaries are kept short and neutral — follow the
    links for each party's own material.
  </p>

  <h2>Standing in the by-election</h2>
  <div class="grid">
    {standing.map((p) => <PartyCard party={p} />)}
  </div>

  {notStanding.length > 0 && (
    <>
      <h2>Not standing</h2>
      <p class="muted">
        These parties contested Clacton in 2024 but have said they will not put
        up a candidate this time. Their own words on why are summarised below;
        the percentages show how each did in the constituency in 2024.
      </p>
      <div class="grid">
        {notStanding.map((p) => <PartyCard party={p} notStanding />)}
      </div>
    </>
  )}

  {independent && (
    <>
      <h2>Independents and smaller parties</h2>
      <p>{independent.summary}</p>
    </>
  )}

  <h2>The starting point: 2024</h2>
  <ResultsBar />
</Base>
