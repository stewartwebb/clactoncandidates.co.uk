---
import election from '../data/election.json';
import parties from '../data/parties.json';

interface Props {
  /** Show all candidates, or collapse below this share into "Others" */
  minPct?: number;
}

const { minPct = 1 } = Astro.props;
const { results, turnout, turnoutPct, majority } = election.result2024;

const partyBySlug = new Map(parties.map((p) => [p.slug, p]));
const fallbackColor = '#999999';

// Minor parties from past results that don't need a full profile in parties.json
const fallbackNames: Record<string, string> = {
  ukip: 'UKIP',
  climate: 'Climate Party',
  heritage: 'Heritage Party',
};
const partyName = (slug: string) =>
  partyBySlug.get(slug)?.shortName ?? fallbackNames[slug] ?? slug;

const main = results.filter((r) => r.pct >= minPct);
const others = results.filter((r) => r.pct < minPct);
const othersVotes = others.reduce((sum, r) => sum + r.votes, 0);
const othersPct = Math.round(others.reduce((sum, r) => sum + r.pct, 0) * 10) / 10;

const rows = [
  ...main.map((r) => ({
    label: partyName(r.party),
    candidate: r.candidate,
    votes: r.votes,
    pct: r.pct,
    color: partyBySlug.get(r.party)?.color ?? fallbackColor,
  })),
  ...(others.length
    ? [{ label: 'Others', candidate: `${others.length} other candidates`, votes: othersVotes, pct: othersPct, color: fallbackColor }]
    : []),
];

const maxPct = Math.max(...rows.map((r) => r.pct));
const fmt = new Intl.NumberFormat('en-GB');
---

<figure>
  <figcaption>
    <strong>2024 general election result in Clacton</strong>
    <span class="muted small">
      Turnout {fmt.format(turnout)} ({turnoutPct}%) · Majority {fmt.format(majority)}
    </span>
  </figcaption>
  <div class="chart" role="img" aria-label={`Bar chart of the 2024 general election result in Clacton: ${rows.map((r) => `${r.label} ${r.pct}%`).join(', ')}`}>
    {rows.map((row) => (
      <div class="row">
        <span class="label">{row.label}</span>
        <span class="track">
          <span class="bar" style={`width:${(row.pct / maxPct) * 100}%;background:${row.color}`}></span>
        </span>
        <span class="value">{row.pct}%</span>
      </div>
    ))}
  </div>
  <details>
    <summary class="small">Full result as a table</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Candidate</th>
            <th scope="col">Party</th>
            <th scope="col" class="num">Votes</th>
            <th scope="col" class="num">Share</th>
          </tr>
        </thead>
        <tbody>
          {results.map((r) => (
            <tr>
              <td>{r.candidate}</td>
              <td>{partyName(r.party)}</td>
              <td class="num">{fmt.format(r.votes)}</td>
              <td class="num">{r.pct}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  figure {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .chart {
    display: grid;
    gap: 0.5rem;
  }

  .row {
    display: grid;
    grid-template-columns: 6rem 1fr 3.25rem;
    align-items: center;
    gap: 0.75rem;
  }

  .label {
    font-size: 0.875rem;
    color: var(--ink-secondary);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track { min-width: 0; }

  .bar {
    display: block;
    height: 14px;
    border-radius: 0 4px 4px 0;
    min-width: 2px;
  }

  .value {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  details { margin-top: 1rem; }
  summary { cursor: pointer; color: var(--ink-secondary); }
  details[open] summary { margin-bottom: 0.5rem; }
</style>
